{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.patricktobias86/dynamic-telegram-bot-api-mcp",
  "description": "A dynamic, self-refreshing MCP gateway for the complete Telegram Bot API",
  "repository": {
    "url": "https://github.com/PrimeUpYourLife/dynamic-telegram-bot-api-mcp",
    "source": "github"
  },
  "version": "10.3.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "dynamic-telegram-bot-api-mcp",
      "version": "10.3.4",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Telegram Bot API token from @BotFather",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "TELEGRAM_BOT_TOKEN"
        }
      ]
    }
  ]
}
